# Reproducibility driver for the race-mode online-tuning results and paper figures.
#   make -f Makefile.race all        # train -> analysis -> figures -> tikz -> gifs
#   make -f Makefile.race figures    # just re-make the paper PDFs from the banked nets
# Every target prints the exact command it runs. Override any VAR on the command line, e.g.
#   make -f Makefile.race train SEEDS=3 EPISODES=14
#
# The pipeline is deterministic: the STD plant is deterministic and every RNG is seeded, so a
# given (code, params, seed) regenerates identical nets, JSON, figures and GIFs. Seeds vary the
# scenario PHYSICALLY (start s0/v0 + opponent placement), not just an RNG draw.

# ---- environment (acados C-codegen stack) -- override to match your machine -----------------
ACADOS_SOURCE_DIR ?= /home/poxx/acados-v060
SCUDERIA         ?= /home/poxx/github/scuderia_gym_jax
export ACADOS_SOURCE_DIR
export LD_LIBRARY_PATH := $(ACADOS_SOURCE_DIR)/lib
export PYTHONPATH := $(ACADOS_SOURCE_DIR)/interfaces/acados_template:$(SCUDERIA):.
export OMP_NUM_THREADS := 1
export XLA_PYTHON_CLIENT_PREALLOCATE := false
PY ?= python3

# ---- canonical experiment parameters (the paper's policy) -----------------------------------
# The policy constants (KV_FLOOR=0.56, KV_CEIL=0.62, A_LAT_RACE=9.0, FAIR_PACE 0.8/1.0/1.05,
# two-layer corridor) live in experiments/race_mode.py -- single source of truth, not duplicated
# here. Change them there and re-run `make -f Makefile.race all`.
ARMS     ?= ltc mlp
SEEDS    ?= 3
EPISODES ?= 14
STEPS    ?= 4000
JOBS     ?= 3
RUN      ?= results/race/race_phase1.json     # canonical training output (nets + json + traj)
FIGSEED  ?= 0                                  # which seed the per-case paper figures use

.PHONY: all train analysis figures tikz gifs figures-all clean-figures print-config sensor sensor-train sensor-eval

all: train analysis figures-all
	@echo "== reproduced: training + analysis + figures + tikz + gifs =="

print-config:
	@echo "ACADOS_SOURCE_DIR=$(ACADOS_SOURCE_DIR)  SCUDERIA=$(SCUDERIA)"
	@echo "ARMS='$(ARMS)' SEEDS=$(SEEDS) EPISODES=$(EPISODES) STEPS=$(STEPS) JOBS=$(JOBS)"
	@echo "RUN=$(RUN)  FIGSEED=$(FIGSEED)"
	@$(PY) -c "from experiments.race_mode import KV_FLOOR,KV_CEIL,A_LAT_RACE,FAIR_PACE; print('KV_FLOOR',KV_FLOOR,'KV_CEIL',KV_CEIL,'A_LAT_RACE',A_LAT_RACE,'FAIR_PACE',FAIR_PACE)"

# 1) TRAIN: online RL over $(EPISODES) episodes/seed -> results/race/nets/race_<arm>_<seed>.npz,
#    the $(RUN) JSON (per-episode rows) and results/race/traj/ dumps.
train:
	$(PY) experiments/race_mode.py --arms $(ARMS) --seeds $(SEEDS) --episodes $(EPISODES) \
	    --steps $(STEPS) --jobs $(JOBS) --fair-opp --dump-traj --out $(RUN)

# 2) ANALYSIS: CSV tables + the learning figures (by-opponent, over-episodes, sectors).
analysis:
	$(PY) tools/race_analysis.py $(notdir $(RUN))
	$(PY) tools/race_table.py $(RUN)

# 3) FIGURES: the paper PDFs+PNGs. Re-drives the ONLINE policy (explore+learn) from the banked
#    nets, seeded -> reproducible. Caches state logs so re-runs are instant (delete
#    results/race/paper/states_online_*.npz to force a fresh re-drive).
figures:
	$(PY) tools/paper_race_learning.py --seed $(FIGSEED)
	$(PY) tools/paper_race_weight_learning_map.py --seed $(FIGSEED) --tikz  # where the tuner adapts weights most (online caches)

# 4) TIKZ: pgfplots .tex of the same figures (into results/race/paper/tikz/).
tikz:
	$(PY) tools/paper_race_tikz.py --seed $(FIGSEED)

# 5) GIFS: per-case race animations from the same online caches.
gifs:
	$(PY) tools/paper_race_gifs.py --seed $(FIGSEED)

# 6) TEN-LAP: full-race (~10 laps) evaluation -- the r_a-floor band is applied automatically via
#    redrive -> 10-lap tables (race_10lap_{frozen,online}.md) + state caches, then the NEW
#    states-over-10-laps figure (fig_10lap_states). A real race is ~10 laps, not the ~4.6 of a
#    training episode, so this is where the faster-opponent band fix shows (3.65 OFF -> 11.84 CLEAN).
tenlap:
	$(PY) tools/race_eval_laps.py --seed $(FIGSEED) --frozen
	$(PY) tools/race_eval_laps.py --seed $(FIGSEED)
	$(PY) tools/paper_race_10lap_states.py --seed $(FIGSEED) --tikz    # 10-lap states + weight-adaptation (PDF+TikZ)
	$(PY) tools/paper_race_overtake_zoom.py --seed $(FIGSEED) --tikz   # track-opponents + zoomed overtakes (PDF+TikZ)
	$(PY) tools/paper_race_track2d.py --seed $(FIGSEED) --tikz         # raceline + fading trails + lap-1/5/10 stages (PDF+TikZ)
	$(PY) tools/paper_race_gifs.py --seed $(FIGSEED) --frozen --kinds static slower equal faster  # all-clean 10-lap gifs
	$(PY) tools/paper_race_weight_gif.py --seed $(FIGSEED)            # weight-learning gifs (live weight bars, online caches)

# COMPUTATIONAL-TIME analysis (acados solve vs horizon vs 20 Hz budget). Run on an IDLE machine --
# a concurrent CPU-heavy job inflates and flattens the numbers (contention, not solve cost).
timing:
	$(PY) tools/paper_solve_timing.py   # -> results/race/solve_timing.md + paper/fig_solve_timing.{pdf,png}

# PHASE-2 SENSOR GATE (partial observability): retrain BOTH arms under range+FOV, then eval on the two
# cases (overtake-then-blind, faster-re-approach) emitting every format (data/csv/png/tikz/gif). All in
# results/race_phase2/ (never mixed with results/race/). SENSOR_R / SENSOR_FOV override the sensor.
# Real sensor: 18 m range, 270-deg lidar coverage (rear ~90 deg blind -- spoiler), + car-height WALL
# OCCLUSION (--occlude). The opponent is unseen ~80-90% of the time on this twisty track.
SENSOR_R   ?= 18
SENSOR_FOV ?= 270
sensor-train:                        # banked warm-start nets under the real sensor (r_a-floor band = 10, classes 1-3)
	$(PY) experiments/race_mode.py --arms ltc mlp --seeds 4 --episodes $(EPISODES) --steps $(STEPS) \
	    --jobs 2 --fair-opp --detect-range $(SENSOR_R) --fov-deg $(SENSOR_FOV) --occlude --out results/race_phase2/race_phase2_sensor.json
sensor-eval:                         # the ONLINE method (learns during the race) under the real sensor -> 4/4 clean
	$(PY) experiments/race_sensor_eval.py --online --arms ltc --seeds 0 1 --detect-range $(SENSOR_R) --fov-deg $(SENSOR_FOV) --occlude
sensor: sensor-train sensor-eval

figures-all: figures tikz gifs tenlap

clean-figures:                       # drop the re-drive caches so `figures` re-simulates
	rm -f results/race/paper/states_online_ltc_*.npz results/race/paper/states_ltc_*.npz

# seed-count VIEWS so you can CHOOSE 5 vs 6 seeds. The N-seed result is the first N seeds of the
# deterministic canonical run (no retraining; seeds 0..N-1 are bit-identical), so it is provably
# consistent. Produces *_5seed tables + learning figures beside the default 6-seed ones, plus a
# 5-vs-6 comparison. SEED5=5 can be overridden.
SEED_VARIANTS ?= 5 6
seed-variants:
	@for n in $(SEED_VARIANTS); do \
	  echo "== $$n-seed view =="; \
	  $(PY) tools/race_subset.py $$n; \
	  $(PY) tools/race_analysis.py race_phase1_$${n}seed.json; \
	  RACE_RUN_JSON=results/race/race_phase1_$${n}seed.json FIG_SUFFIX=_$${n}seed \
	      $(PY) tools/paper_race_learning.py --learning-only; \
	done
	$(PY) tools/race_seed_compare.py 5 6                             # results/race/seed_choice.md
	@echo "== tagged views written (fig_learn_*_5seed / _6seed, *_5seed / *_6seed CSVs); the untagged"
	@echo "   default plots (the current 6-seed) are NOT touched by this target =="
