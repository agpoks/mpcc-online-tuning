{
  "$schema": "https://foxglove.dev/schemas/studio-layout.json",
  "configById": {
    "3D!m3d": {
      "followMode": "follow-pose",
      "scene": {
        "enableStats": false
      },
      "transforms": {},
      "topics": {
        "/pf/viz/inferred_pose": {
          "visible": true
        },
        "/odom": {
          "visible": true
        },
        "/ackermann_cmd": {
          "visible": false
        }
      },
      "layers": {},
      "cameraState": {
        "distance": 18.0,
        "perspective": true,
        "phi": 35.0,
        "thetaOffset": 0.0,
        "targetOffset": [
          0,
          0,
          0
        ],
        "target": [
          0,
          0,
          0
        ],
        "targetOrientation": [
          0,
          0,
          0,
          1
        ],
        "fovy": 45.0,
        "near": 0.5,
        "far": 5000.0
      },
      "publish": {
        "type": "point",
        "poseTopic": "/move_base_simple/goal"
      },
      "imageMode": {},
      "synchronize": false
    },
    "Gauge!g_speed": {
      "title": "Speed vx [m/s]",
      "path": "/odom.twist.twist.linear.x",
      "minValue": 0,
      "maxValue": 8,
      "colorMode": "colormap",
      "colorMap": "turbo",
      "reverse": false
    },
    "Gauge!g_solve": {
      "title": "Solve time [ms]  (20 Hz budget = 50)",
      "path": "/mpcc_online/debug/solve_ms.data",
      "minValue": 0,
      "maxValue": 80,
      "colorMode": "colormap",
      "colorMap": "turbo",
      "reverse": true
    },
    "Gauge!g_off": {
      "title": "Off-track flag (0=in / 1=OUT)",
      "path": "/mpcc_online/debug/off.data",
      "minValue": 0,
      "maxValue": 1,
      "colorMode": "colormap",
      "colorMap": "red-yellow-green",
      "reverse": true
    },
    "Plot!w": {
      "title": "Online-tuned MPCC weights (adapting live)",
      "paths": [
        {
          "value": "/mpcc_online/debug/k_v.data",
          "label": "k_v",
          "color": "#2196F3",
          "enabled": true,
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/mpcc_online/debug/q_c.data",
          "label": "q_c",
          "color": "#FF9800",
          "enabled": true,
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/mpcc_online/debug/q_l.data",
          "label": "q_l",
          "color": "#4CAF50",
          "enabled": true,
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/mpcc_online/debug/r_a.data",
          "label": "r_a",
          "color": "#F44336",
          "enabled": true,
          "timestampMethod": "receiveTime"
        }
      ],
      "xAxisVal": "timestamp",
      "isSynced": true,
      "showLegend": true,
      "showPlotValuesInLegend": true,
      "legendDisplay": "floating",
      "followingViewWidth": 30
    },
    "Plot!pace": {
      "title": "Pace \u2014 vx actual vs drive command",
      "paths": [
        {
          "value": "/odom.twist.twist.linear.x",
          "label": "vx actual [m/s]",
          "color": "#4CAF50",
          "enabled": true,
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/mpcc_online/debug/accel.data",
          "label": "accel cmd [m/s^2]",
          "color": "#9C27B0",
          "enabled": true,
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/ackermann_cmd.drive.steering_angle",
          "label": "steer cmd [rad]",
          "color": "#FFC107",
          "enabled": true,
          "timestampMethod": "receiveTime"
        }
      ],
      "xAxisVal": "timestamp",
      "isSynced": true,
      "showLegend": true,
      "showPlotValuesInLegend": true,
      "legendDisplay": "floating",
      "followingViewWidth": 30
    },
    "Plot!track": {
      "title": "Tracking \u2014 lateral error & off-track",
      "paths": [
        {
          "value": "/mpcc_online/debug/lateral.data",
          "label": "lateral error [m]",
          "color": "#00BCD4",
          "enabled": true,
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/mpcc_online/debug/off.data",
          "label": "off-track (0/1)",
          "color": "#F44336",
          "enabled": true,
          "timestampMethod": "receiveTime"
        }
      ],
      "xAxisVal": "timestamp",
      "isSynced": true,
      "showLegend": true,
      "showPlotValuesInLegend": true,
      "legendDisplay": "floating",
      "followingViewWidth": 30
    },
    "Plot!solve": {
      "title": "Solve time [ms] (keep < 50 for 20 Hz)",
      "paths": [
        {
          "value": "/mpcc_online/debug/solve_ms.data",
          "label": "solve_ms",
          "color": "#FF5722",
          "enabled": true,
          "timestampMethod": "receiveTime"
        }
      ],
      "xAxisVal": "timestamp",
      "isSynced": true,
      "showLegend": true,
      "showPlotValuesInLegend": true,
      "legendDisplay": "floating",
      "followingViewWidth": 30
    },
    "Plot!prog": {
      "title": "Progress s [m] along the corridor",
      "paths": [
        {
          "value": "/mpcc_online/debug/s.data",
          "label": "s [m]",
          "color": "#3F51B5",
          "enabled": true,
          "timestampMethod": "receiveTime"
        }
      ],
      "xAxisVal": "timestamp",
      "isSynced": true,
      "showLegend": true,
      "showPlotValuesInLegend": true,
      "legendDisplay": "floating",
      "followingViewWidth": 30
    },
    "RawMessages!drive": {
      "topicPath": "/ackermann_cmd"
    },
    "RawMessages!enable": {
      "topicPath": "/mpcc/enable"
    },
    "Tab!main": {
      "activeTabIdx": 0,
      "tabs": [
        {
          "title": "MPCC Online",
          "layout": {
            "direction": "row",
            "first": "3D!m3d",
            "splitPercentage": 44,
            "second": {
              "direction": "column",
              "splitPercentage": 26,
              "first": {
                "direction": "row",
                "first": "Gauge!g_speed",
                "splitPercentage": 34,
                "second": {
                  "direction": "row",
                  "first": "Gauge!g_solve",
                  "second": "Gauge!g_off",
                  "splitPercentage": 50
                }
              },
              "second": {
                "direction": "column",
                "first": "Plot!w",
                "second": "Plot!pace",
                "splitPercentage": 58
              }
            }
          }
        },
        {
          "title": "Online tuning",
          "layout": {
            "direction": "row",
            "splitPercentage": 58,
            "first": "Plot!w",
            "second": {
              "direction": "column",
              "splitPercentage": 50,
              "first": "Plot!track",
              "second": {
                "direction": "column",
                "first": "Plot!solve",
                "second": "RawMessages!enable",
                "splitPercentage": 60
              }
            }
          }
        },
        {
          "title": "Control",
          "layout": {
            "direction": "row",
            "splitPercentage": 60,
            "first": {
              "direction": "column",
              "first": "Plot!pace",
              "second": "Plot!prog",
              "splitPercentage": 55
            },
            "second": {
              "direction": "column",
              "first": "RawMessages!drive",
              "second": "Gauge!g_off",
              "splitPercentage": 55
            }
          }
        }
      ]
    }
  },
  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": {
    "speed": 1.0
  },
  "layout": "Tab!main"
}