# --- run artifacts ---
# Per-experiment scratch only. Figures are NOT excluded: a docs build cannot
# run IPOPT, so every figure has to be in the tree, and a global *.png rule
# drops new ones silently.
runs/
c_generated_code/
# the export ROOT too: acados_export and the sweeps write solver trees
# here and it reaches 241 MB. Only c_generated_code/ was ignored before.
c_generated/
acados_ocp*.json

# --- sphinx build output ---
docs/_build/

# --- LaTeX build products ---
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.pdf
paper/*.synctex.gz
